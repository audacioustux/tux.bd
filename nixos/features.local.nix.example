# Copy this file to features.local.nix (gitignored).
# It enables optional services that need machine-specific secrets or state.
{ ... }:
{
  tux = {
    # Cloudflare Tunnel. Requires /persist/cloudflared/token.
    cloudflared.enable = true;

    # Single-node Docker Swarm + k8swalski stack.
    swarm.enable = true;

    # GitHub Actions runner for the nobinalo org.
    # Requires /persist/github-runner/token.
    githubRunner.enable = true;

    # Development VMs. See devbox/README.md.
    devboxes.main = {
      sshPort = 2222;
      authorizedKeys = [ # gh:audacioustux
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJLX6Wvv1eDie4pFped80zbqUFRWcZYqPQCHQEpw/yQ2"
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXWBoJfED5lM/FJUoGLxUqAac/NWCQymTCaGeaiWNjv"
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGXNKahPnaurOeUauQ+2Ze5OHOYV8THfoph0b6jkLHPc"
      ];
      vcpu = 6;        # of 8
      memory = 6144;   # MiB, of 11.5 GiB; the ZFS cache is capped to leave room
      docker = true;   # multi-node simulations
      # relay creates and deletes tens of GB of clones a day.
      unsnapshottedPaths = [ ".local/share/relay" ];
    };
  };
}
